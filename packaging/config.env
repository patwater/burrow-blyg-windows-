# Packaging constants, sourced by scripts/*.sh. Plain KEY=value lines only
# (the release workflow reads this file too).

# The GitHub repository (a placeholder until it's set). Change it everywhere at
# once with `scripts/set-repo.sh <owner>/<name>`, which also updates Cargo.toml,
# scripts/install.sh and README.md. The workflows use github.repository at run
# time and warn if this doesn't match.
GITHUB_REPO=aneeshsathe/blygger-desktop

APP_NAME=Blygger
BUNDLE_ID=org.blygger.desktop
BINARY_NAME=blygger
CARGO_PACKAGE=blyg-app

# GPUI itself targets macOS 10.15, but Rust's aarch64-apple-darwin target
# starts at 11.0, so a universal build can't promise less than Big Sur.
MACOS_MIN=11.0
APP_CATEGORY=public.app-category.productivity
