{
  "openapi": "3.1.0",
  "info": {
    "title": "Owner API extensions (not upstream)",
    "version": "0.11",
    "description": "Routes and replies the app uses that upstream blygger-studio's openapi.json lacks. Written from the Worker fork's extension contract; see docs/SERVER.md. Upstream operations are checked against openapi.json; an operation here is checked against this file, and a reply status upstream doesn't declare (POST /api/media 200) falls back to it."
  },
  "paths": {
    "/api/reading/imported": {
      "get": {
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            }
          },
          {
            "in": "query",
            "name": "before",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ReadingRow"
                      }
                    },
                    "next": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "read_state": {
                      "type": "boolean"
                    },
                    "lineage": {
                      "type": "boolean",
                      "description": "Rows carry stub_of and forked_from (null when none)."
                    }
                  },
                  "required": [
                    "items",
                    "next"
                  ]
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown item, or a server without this extension.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/items/{id}/tk-provenance": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "scopes": {
                      "type": "array",
                      "items": {
                        "anyOf": [
                          {
                            "$ref": "#/components/schemas/StoredScope"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    }
                  },
                  "required": [
                    "scopes"
                  ]
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "put": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "scopes": {
                    "type": "array",
                    "items": {
                      "anyOf": [
                        {
                          "$ref": "#/components/schemas/ScopeInput"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "content_md": {
                    "type": "string"
                  }
                },
                "required": [
                  "scopes"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "disclosed": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "ok",
                    "disclosed"
                  ]
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/reading/{sub}/{remoteId}/read": {
      "put": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "version": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4294967295
                  }
                },
                "required": [
                  "version"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "stored": {
                      "type": "boolean"
                    },
                    "read_version": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "ok",
                    "stored",
                    "read_version"
                  ]
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown item, or a server without this extension.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/reading/read": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "items": {
                    "type": "array",
                    "maxItems": 500,
                    "items": {
                      "type": "object",
                      "properties": {
                        "sub": {
                          "type": "string",
                          "minLength": 1
                        },
                        "remote_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "version": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 4294967295
                        }
                      },
                      "required": [
                        "sub",
                        "remote_id",
                        "version"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "items"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "received": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "ok",
                    "received"
                  ]
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown item, or a server without this extension.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/media": {
      "post": {
        "responses": {
          "200": {
            "description": "The same bytes are already attached to that item: the existing row, nothing stored.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string"
                    },
                    "mime": {
                      "type": "string"
                    },
                    "duplicate": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "url",
                    "mime",
                    "duplicate"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "error"
        ]
      },
      "Source": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "ScopeInput": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "model": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Source"
            }
          },
          "at": {
            "type": "string"
          }
        },
        "required": [
          "index",
          "model"
        ],
        "additionalProperties": false
      },
      "StoredScope": {
        "type": "object",
        "properties": {
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "version": {
                  "type": "integer"
                }
              },
              "required": [
                "id",
                "version"
              ]
            }
          },
          "model": {
            "type": "string"
          },
          "at": {
            "type": "string"
          }
        },
        "required": [
          "sources",
          "model",
          "at"
        ]
      },
      "ReadingRow": {
        "type": "object",
        "properties": {
          "subscription_id": {
            "type": "string"
          },
          "remote_id": {
            "type": "string"
          },
          "subscription_title": {
            "type": "string"
          },
          "origin": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "fragment",
              "thread"
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "current",
              "tombstone"
            ]
          },
          "version": {
            "type": "integer",
            "minimum": 0
          },
          "created": {
            "type": [
              "string",
              "null"
            ]
          },
          "updated": {
            "type": [
              "string",
              "null"
            ]
          },
          "observed_at": {
            "type": "string"
          },
          "content_md": {
            "type": "string"
          },
          "content_html": {
            "type": "string"
          },
          "author": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "url": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "name",
                  "url"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "page": {
            "type": [
              "string",
              "null"
            ]
          },
          "thumb": {
            "anyOf": [
              {
                "enum": [
                  1,
                  -1
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "hoppers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "read_version": {
            "type": [
              "integer",
              "null"
            ]
          },
          "transclusions": {
            "type": [
              "array",
              "null"
            ]
          },
          "pinned_version_retained": {
            "type": [
              "integer",
              "null"
            ]
          },
          "stub_of": {
            "anyOf": [
              {
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "The item's stub_of as imported (studio 0.18+), verbatim: {origin,id,version,cited?} or {url,cited?}. Present when the page says lineage: true."
          },
          "forked_from": {
            "anyOf": [
              {
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "The item's forked_from as imported, verbatim. Present when the page says lineage: true."
          }
        },
        "required": [
          "subscription_id",
          "remote_id",
          "subscription_title",
          "origin",
          "kind",
          "state",
          "version",
          "created",
          "updated",
          "observed_at",
          "content_md",
          "content_html",
          "author",
          "page",
          "thumb",
          "hoppers",
          "read_version",
          "transclusions",
          "pinned_version_retained"
        ]
      }
    }
  }
}
